rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSuperAdmin() {
      return request.auth != null
        && request.auth.uid == 'NiquOT8pm7hha8mM6nlsuYvN0tr1';
    }

    function isSchoolAdmin(schoolId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/schools/$(schoolId))
        && get(/databases/$(database)/documents/schools/$(schoolId)).data.adminUid == request.auth.uid;
    }

    match /schools/{schoolId} {
      allow read: if isSuperAdmin()
        || (request.auth != null && resource.data.adminUid == request.auth.uid);

      allow create: if isSuperAdmin();

      allow update: if isSuperAdmin()
        || (
          isSchoolAdmin(schoolId)
          && request.resource.data.adminUid == resource.data.adminUid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['mustChangePassword', 'activated', 'lastLoginAt'])
          && request.resource.data.mustChangePassword == false
          && request.resource.data.activated == true
        );

      allow delete: if false;

      match /students/{studentId} {
        allow read, write: if isSuperAdmin() || isSchoolAdmin(schoolId);
      }
    }

    match /schoolCodes/{code} {
      allow read: if isSuperAdmin()
        || (request.auth != null && resource.data.adminUid == request.auth.uid);

      allow create: if isSuperAdmin();

      allow update, delete: if false;
    }

    match /payments/{paymentId} {
      allow read, create: if isSuperAdmin();
      allow update, delete: if false;
    }

    match /presence/{uid} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /superAdminProfile/{uid} {
      allow read, write: if isSuperAdmin()
        && request.auth.uid == uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
